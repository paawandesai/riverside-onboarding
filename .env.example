# Copy to .env and fill in. Never commit .env.
# --- App ---
# Defaults to production (Secure cookies, no API docs) when unset; use development locally.
APP_ENV=development
# 32+ random bytes, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SESSION_SECRET=change-me
# Fernet key for field-level encryption of identity fields (comma-separate several to rotate; the first encrypts):
# `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`
FIELD_ENCRYPTION_KEY=change-me
# Keys the email lookup hash; must differ from SESSION_SECRET (same command, run again)
EMAIL_HMAC_KEY=change-me
# Comma-separated invite codes that allow sign-up (demo gating)
INVITE_CODES=change-me
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
# Hours before stored demo data is purged by scripts/purge_demo_data.py
DEMO_RETENTION_HOURS=24
# Optional, used by `python -m scripts.seed --demo-user --demo-staff --sample-patients`:
# DEMO_USER_EMAIL=demo@example.com
# DEMO_USER_PASSWORD=
# DEMO_STAFF_EMAIL=staff@example.com
# DEMO_STAFF_PASSWORD=
# Set to any value to keep made-up sample patients booked (seed and the purge job)
# DEMO_SAMPLE_PATIENTS=true
# Appointment slots are generated 9:00-16:30 in this zone
CLINIC_TIMEZONE=America/New_York
# Per-worker rate limits on sign-in, sign-up, chat and uploads
RATE_LIMITS_ENABLED=true
# Anonymous step events for the staff analytics are deleted after this many days.
ANALYTICS_RETENTION_DAYS=30
# Trusted proxies that append X-Forwarded-For (0 locally, 1 behind Azure Container Apps)
FORWARDED_IP_HOPS=0

# --- Database ---
# Used by docker-compose for the local Postgres container.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+pg8000://onboarding:change-me@localhost:5432/onboarding
# true for Azure Database for PostgreSQL (TLS required)
DATABASE_SSL=false
# Tests drop every table, so they use their own database (its name must end in _test).
TEST_DATABASE_URL=postgresql+pg8000://onboarding:change-me@localhost:5432/onboarding_test
# The container runs `alembic upgrade head` on start unless this is false (Azure uses an init container).
RUN_MIGRATIONS=true
# Folder of the built frontend the API serves (the Docker image sets this; e2e points it at frontend/dist).
STATIC_DIR=static

# --- Claude API (paid; key from a Claude Console organization) ---
# Leave empty to run with the rule-based fallback only. ANTHROPIC_API_KEY is also accepted.
ANTHROPIC_RIVERSIDE_API_KEY=
# Model id is configuration. Checked against the Models API at startup.
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_TIMEOUT_SECONDS=6

# --- OCR ---
TESSERACT_CMD=tesseract
MAX_UPLOAD_MB=8
