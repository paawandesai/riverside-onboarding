# Copy to .env and fill in. Never commit .env.
# --- App ---
APP_ENV=development
# 32+ random bytes, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SESSION_SECRET=change-me
# Fernet key for field-level encryption of identity fields:
# `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`
FIELD_ENCRYPTION_KEY=change-me
# Comma-separated invite codes that allow sign-up (demo gating)
INVITE_CODES=change-me
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
# Hours before stored demo data is purged by scripts/purge_demo_data.py
DEMO_RETENTION_HOURS=24

# --- Database ---
# Used by docker-compose for the local Postgres container.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+pg8000://onboarding:change-me@localhost:5432/onboarding

# --- Claude API (paid; key from a Claude Console organization) ---
# Leave empty to run with the rule-based fallback only. ANTHROPIC_API_KEY is also accepted.
ANTHROPIC_RIVERSIDE_API_KEY=
# Model id is configuration. Checked against the Models API at startup.
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_TIMEOUT_SECONDS=6

# --- OCR ---
TESSERACT_CMD=tesseract
MAX_UPLOAD_MB=8
